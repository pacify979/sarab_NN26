.venv/
__pycache__/
*.pyc

# Parsed-sequence cache -- regenerated automatically
.cache/

# ETH-UCY data: 14 MB of third-party data, fetched by scripts/download_data.sh
data/

# Model checkpoints are binary and are regenerated by training...
*.pt
# ...but results, logs and figures stay in the repo since they go into the report.

# LaTeX build artefacts -- regenerated by pdflatex/bibtex on every compile.
# The .tex sources, refs.bib, figures and the final .pdf ARE tracked.
docs/paper/*.aux
docs/paper/*.log
docs/paper/*.out
docs/paper/*.bbl
docs/paper/*.blg
docs/paper/*.synctex.gz
docs/paper/*.fls
docs/paper/*.fdb_latexmk
docs/paper/*.toc

# Serbian version of the paper: kept locally, not committed.
# (figures/sr/ stays tracked -- those images are also the source of the presentation)
docs/paper/rad_sr.*
